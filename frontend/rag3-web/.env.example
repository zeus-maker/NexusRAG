# 开发代理目标（RAGFlow API 默认 9380）
# VITE_PROXY_TARGET=http://localhost:9380

# 启用真实 API（true 时对接 RAGFlow /v1/*）
# 本地 dev 默认见 .env.development（已为 true）
VITE_USE_REAL_API=false

# 可选：预置 Authorization（跳过登录，开发调试用）
# VITE_RAGFLOW_AUTH_TOKEN=your-token-here

# 可选：直连 API 根路径（生产构建）
# VITE_API_BASE=https://your-host/api
